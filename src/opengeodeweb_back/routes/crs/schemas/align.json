{
  "route": "/align",
  "methods": [
    "POST"
  ],
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "mode": {
      "type": "string",
      "enum": [
        "similarity",
        "affine"
      ]
    },
    "source_points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "picked": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false
      }
    },
    "target_points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false
      }
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "source_points",
    "target_points",
    "authority",
    "code",
    "name"
  ],
  "additionalProperties": false,
  "response": {
    "type": "object",
    "properties": {
      "binary_light_viewable": {
        "type": "string"
      },
      "crs": {
        "type": "object",
        "properties": {
          "authority": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "authority",
          "code",
          "name"
        ],
        "additionalProperties": false
      },
      "scale": {
        "type": "number"
      },
      "rotation": {
        "type": "number"
      }
    },
    "required": [],
    "additionalProperties": false
  }
}
