{
  "route": "/allowed_objects",
  "methods": [
    "POST"
  ],
  "type": "object",
  "properties": {
    "filename": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "filename"
  ],
  "additionalProperties": false,
  "response": {
    "type": "object",
    "properties": {
      "allowed_objects": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "is_loadable": {
              "type": "number"
            },
            "object_priority": {
              "type": "integer"
            },
            "loadable_family": {
              "type": "string"
            }
          },
          "required": [
            "is_loadable",
            "object_priority",
            "loadable_family"
          ],
          "additionalProperties": false
        }
      },
      "objects_to_load": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "allowed_objects",
      "objects_to_load"
    ],
    "additionalProperties": false
  }
}