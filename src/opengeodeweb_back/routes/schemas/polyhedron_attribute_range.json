{
  "route": "/polyhedron_attribute_range",
  "methods": [
    "POST"
  ],
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    },
    "attribute_name": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "attribute_name"
  ],
  "additionalProperties": false,
  "response": {
    "type": "object",
    "properties": {
      "min_values": {
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "max_values": {
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "no_data": {
        "type": "boolean"
      }
    },
    "required": [
      "min_values",
      "max_values",
      "no_data"
    ],
    "additionalProperties": false
  }
}
