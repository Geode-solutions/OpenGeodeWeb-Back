{
  "route": "/vertex_attribute_names",
  "methods": [
    "POST"
  ],
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32
    }
  },
  "required": [
    "id"
  ],
  "additionalProperties": false,
  "response": {
    "type": "object",
    "properties": {
      "attributes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "attribute_name": {
              "type": "string"
            },
            "attribute_id": {
              "type": "string"
            },
            "nb_items": {
              "type": "integer"
            },
            "time_steps": {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "attribute_name",
            "attribute_id",
            "nb_items",
            "time_steps"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "attributes"
    ],
    "additionalProperties": false
  }
}